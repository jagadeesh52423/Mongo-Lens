    "port": 2222,
    "user": "carol",
    "auth": {
      "kind": "key",
      "keyPath": "/Users/carol/.ssh/id_ed25519",
      "hasPassphrase": false
    },
    "knownHostsPolicy": "add-and-trust"
  },
  "createdAt": "2026-05-05T00:00:00Z"
}

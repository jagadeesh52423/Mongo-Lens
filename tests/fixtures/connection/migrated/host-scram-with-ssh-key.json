{
  "id": "lc-host-scram-with-ssh-key",
  "name": "Legacy: SCRAM + SSH key",
  "target": { "kind": "direct", "host": "internal.example", "port": 27017 },
  "auth": {
    "kind": "scram",
    "username": "carol",
    "authDb": "admin",
